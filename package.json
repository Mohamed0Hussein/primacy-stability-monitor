{
  "name": "PrimacyStabilityMonitor",
  "private": true,
  "version": "1.1.4",
  "type": "module",
  "main": "src/electron-start.js",
  "author": "Mohamed0Hussein",
  "description": "Stability Monitor Application for primacy laboratories",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mohamed0Hussein/primacy-stability-monitor.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "electron": "electron . --no-sandbox",
    "start": "electron . --no-sandbox",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always"
  },
  "build": {
    "appId": "com.primacy.stabilitymonitor",
    "productName": "Primacy Stability Monitor",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Mohamed0Hussein",
        "repo": "primacy-stability-monitor"
      }
    ],
    "files": [
      "dist/**/*",
      "src/electron-start.js",
      "src/preload.js",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Primacy Stability Monitor"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@tanstack/react-query": "5.90.12",
    "axios": "1.13.2",
    "electron-updater": "^6.8.9",
    "firebase": "12.6.0",
    "lucide-react": "0.555.0",
    "moment": "2.30.1",
    "react": "19.2.3",
    "react-datepicker": "9.0.0",
    "react-dom": "19.2.3",
    "react-router": "7.9.6",
    "react-router-dom": "7.13.0",
    "tailwindcss": "4.1.17"
  },
  "devDependencies": {
    "@types/react": "18.2.37",
    "@types/react-dom": "18.2.15",
    "@typescript-eslint/eslint-plugin": "6.10.0",
    "@typescript-eslint/parser": "6.10.0",
    "@vitejs/plugin-react": "4.2.0",
    "electron": "33.0.2",
    "electron-builder": "^26.15.3",
    "eslint": "8.53.0",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-react-refresh": "0.4.4",
    "typescript": "5.2.2",
    "vite": "5.4.21"
  }
}
